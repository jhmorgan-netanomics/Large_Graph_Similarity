library(Matrix)
salsa_power <- function(g, score = c("hub","authority"), weights = NULL,
tol = 1e-9, maxit = 1e4, norm = c("l1","l2")) {
score <- match.arg(score); norm <- match.arg(norm)
A <- as_adjacency_matrix(g, attr = weights, sparse = TRUE)   # weights=NULL ⇒ binary
n <- nrow(A)
outdeg <- rowSums(A); outdeg[outdeg == 0] <- 1
indeg  <- colSums(A); indeg[indeg == 0]  <- 1
x <- rep(1/n, n)
normfn <- if (norm == "l1") function(v){ s <- sum(abs(v)); if (s>0) v/s else v }
else               function(v){ s <- sqrt(sum(v*v)); if (s>0) v/s else v }
for (it in 1:maxit) {
if (score == "hub") {
y <- as.numeric(A %*% ( (as.numeric(crossprod(A, x)) / indeg) )) / outdeg
} else {
y <- (as.numeric(crossprod(A, (as.numeric(A %*% x) / outdeg))) ) / indeg
}
y <- normfn(y)
if (sum(abs(y - x)) < tol) { x <- y; break }
x <- y
}
x
}
# SALSA Power Function
salsa_power <- function(g, score = c("hub","authority"), weights = NULL,
tol = 1e-9, maxit = 1e4, norm = c("l1","l2")) {
score <- match.arg(score); norm <- match.arg(norm)
A <- as_adjacency_matrix(g, attr = weights, sparse = TRUE)   # weights=NULL ⇒ binary
n <- nrow(A)
outdeg <- rowSums(A); outdeg[outdeg == 0] <- 1
indeg  <- colSums(A); indeg[indeg == 0]  <- 1
x <- rep(1/n, n)
normfn <- if (norm == "l1") function(v){ s <- sum(abs(v)); if (s>0) v/s else v }
else               function(v){ s <- sqrt(sum(v*v)); if (s>0) v/s else v }
for (it in 1:maxit) {
if (score == "hub") {
y <- as.numeric(A %*% ( (as.numeric(crossprod(A, x)) / indeg) )) / outdeg
} else {
y <- (as.numeric(crossprod(A, (as.numeric(A %*% x) / outdeg))) ) / indeg
}
y <- normfn(y)
if (sum(abs(y - x)) < tol) { x <- y; break }
x <- y
}
x
}
# Compute alignment + metrics (no printing)
score_metrics <- function(x, y) {
if (is.null(names(x)) || is.null(names(y))) {
stop("Both x and y must be named.")
}
common <- intersect(names(x), names(y))
x <- x[common]; y <- y[common]
l1  <- sum(abs(x - y))
l2  <- sqrt(sum((x - y)^2))
cor_p <- suppressWarnings(cor(x, y, method = "pearson"))
cor_s <- suppressWarnings(cor(x, y, method = "spearman"))
list(L1 = l1, L2 = l2, pearson = cor_p, spearman = cor_s, n = length(common))
}
# Pretty-printer for metrics
print_metrics <- function(label, m) {
cat(sprintf("\n[%s] n=%d  L1: %.6g  L2: %.6g  Pearson: %.6f  Spearman: %.6f\n",
label, m$n, m$L1, m$L2, m$pearson, m$spearman))
invisible(m)
}
# Test Function for SALSA Power Method
run_salsa_scc_check <- function(g, weights_attr = NULL,
tol = 1e-9, maxit = 1e4, norm = "l1",
pass_L1 = 1e-6, pass_corr = 0.999) {
# Strong Component Test
comp   <- igraph::components(g, mode = "strong")
scc_id <- which.max(comp$csize)
idx    <- which(comp$membership == scc_id)
gscc   <- igraph::induced_subgraph(g, idx)
cat(sprintf("Largest SCC has %d nodes and %d edges.\n",
igraph::vcount(gscc), igraph::ecount(gscc)))
# Centiserve SALSA (expects strongly connected graph)
hub_cs  <- centiserve::salsa(gscc, score = "hub")
auth_cs <- centiserve::salsa(gscc, score = "authority")
names(hub_cs)  <- igraph::V(gscc)$name
names(auth_cs) <- igraph::V(gscc)$name
# Power method SALSA on the same SCC
hub_pm  <- salsa_power(gscc, score = "hub",        weights = weights_attr,
tol = tol, maxit = maxit, norm = norm)
auth_pm <- salsa_power(gscc, score = "authority",  weights = weights_attr,
tol = tol, maxit = maxit, norm = norm)
# Print-Out Results
cat("\nComparing SALSA hub on SCC (centiserve vs power-method):")
m_hub  <- score_metrics(hub_cs, hub_pm);  print_metrics("Hub", m_hub)
cat("Comparing SALSA authority on SCC (centiserve vs power-method):")
m_auth <- score_metrics(auth_cs, auth_pm); print_metrics("Authority", m_auth)
ok <- (m_hub$L1  <= pass_L1  && m_auth$L1  <= pass_L1) ||
(m_hub$pearson >= pass_corr && m_auth$pearson >= pass_corr)
if (ok) {
cat("\n✅ SCC parity looks good. Proceeding to full-graph power-method…\n")
} else {
cat("\n⚠️  SCC parity is not within thresholds. Inspect differences before proceeding.\n")
}
invisible(list(
ok = ok,
hub_centiserve  = hub_cs,   auth_centiserve = auth_cs,
hub_power       = hub_pm,   auth_power      = auth_pm,
hub_metrics     = m_hub,    auth_metrics    = m_auth,
scc_graph       = gscc
))
}
# Applying Power Method
compute_full_graph_salsa <- function(g, weights_attr = NULL,
tol = 1e-9, maxit = 1e4, norm = "l1") {
hub_full  <- salsa_power(g, score = "hub",        weights = weights_attr,
tol = tol, maxit = maxit, norm = norm)
auth_full <- salsa_power(g, score = "authority",  weights = weights_attr,
tol = tol, maxit = maxit, norm = norm)
list(hub = hub_full, authority = auth_full)
}
